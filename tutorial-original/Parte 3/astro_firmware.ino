// Velocidad de la cancion (mas alto = mas rapido)
int tempo = 120;

// El pin del buzzer
const int buzzer = 3;

// Angulo de reposo de los brazos (90 = centro; evito los extremos 0/180 que
// hacen zumbar y forzar el tope mecanico del SG90).
const int BRAZO_REPOSO = 90;

// --- Melodia: pares (NOTA, duracion) ---
// Duracion: 4=negra, 8=corchea, 16=semicorchea; negativo = con puntillo (x1.5).
// v2: saque el par "14, 99" del original. No era musica: 14 no es ninguna nota
// definida y 99 no es una duracion valida; el parser lo tocaba como ~20ms de
// 14 Hz (inaudible) y de paso movia los servos. Si queres una pausa, es REST.
int melody[] = {
  //TUTU TI TU TU TU TU TURURU
  NOTE_D4, 16, NOTE_D4, 16, NOTE_D5, -16, REST, 32, NOTE_A4, -16, REST, 16,
  NOTE_GS4, 16, REST, 16, NOTE_G4, 16, REST, 16, NOTE_F4, 8, NOTE_D4, 16,
  NOTE_F4, 16, NOTE_G4, 16,
};

// Cantidad total de enteros del arreglo (no de pares); lo recorremos de a 2.
const int melodyLen  = sizeof(melody) / sizeof(melody[0]);
const int wholenote  = (60000 * 4) / tempo;

// ---------------------------------------------------------------------------
//  Estado del "show" (maquina de estados, SIN delay())
// ---------------------------------------------------------------------------
// Idea clave de la v2: en vez de dormir con delay() dentro de setup(), loop()
// corre miles de veces por segundo y en cada pasada pregunta "¿ya toca hacer
// algo?" comparando millis() (ms desde que encendio) contra el momento en que
// vence la nota actual. Es un scheduler cooperativo: el micro nunca se congela,
// asi que puede animar la cara MIENTRAS suena la musica.
bool          showSonando   = false;  // ¿estamos reproduciendo la melodia?
int           notaIndex     = 0;      // posicion dentro de melody[] (avanza de a 2)
unsigned long notaEmpezoEn  = 0;      // millis() en que arranco la nota actual
int           notaDuracionMs = 0;     // cuanto dura la nota actual
bool          poseBrazos    = false;  // alterna la pose de los brazos por nota

// ===========================================================================
//  FUNCIONES AUXILIARES (todas cortas y sin delay)
// ===========================================================================

// Dibuja la cara. offsetY la corre unos pixeles en vertical (para el "respira").
void dibujarCara(int offsetY) {
  display.clearDisplay();
  display.drawBitmap(0, offsetY, epd_bitmap_1, BITMAP_ANCHO, BITMAP_ALTO, WHITE);
  display.display();
}

// Alterna la pose de los brazos en cada nota (bailan al ritmo).
void moverBrazos() {
  poseBrazos = !poseBrazos;
  if (poseBrazos) {
    servoMotor.write(60);    // izquierdo arriba
    servoMotor2.write(120);  // derecho abajo (espejado)
  } else {
    servoMotor.write(120);
    servoMotor2.write(60);
  }
}

// Lee el boton con anti-rebote. Devuelve true SOLO en el instante en que se
// aprieta (flanco de bajada), no mientras lo mantenes apretado.
// Los 'static' hacen que estas variables recuerden su valor entre llamadas.
bool botonRecienApretado() {
  static bool estadoEstable = HIGH;
  static bool ultimaLectura = HIGH;
  static unsigned long tCambio = 0;
  const unsigned long ANTIREBOTE_MS = 30;

  bool lectura = digitalRead(PIN_BOTON);
  if (lectura != ultimaLectura) {          // hubo un cambio: reinicia el reloj
    tCambio = millis();
    ultimaLectura = lectura;
  }
  // Si el nivel se mantuvo estable mas que el anti-rebote, lo aceptamos.
  if (millis() - tCambio > ANTIREBOTE_MS && lectura != estadoEstable) {
    estadoEstable = lectura;
    if (estadoEstable == LOW) return true; // recien apretado
  }
  return false;
}

// Arranca el show desde la primera nota.
void arrancarShow() {
  showSonando    = true;
  notaIndex      = 0;
  notaEmpezoEn   = millis();
  notaDuracionMs = 0;        // 0 => la primera nota suena ya, en la proxima pasada
  dibujarCara(0);            // cara quieta mientras baila (timing de musica prolijo)
}

// Termina el show y deja todo en reposo.
void terminarShow() {
  showSonando = false;
  noTone(buzzer);
  servoMotor.write(BRAZO_REPOSO);
  servoMotor2.write(BRAZO_REPOSO);
}

// Motor del show: avanza una nota SOLO cuando la anterior vencio. Reemplaza al
// for + delay() del original. Cada llamada retorna enseguida.
void actualizarShow() {
  if (!showSonando) return;
  // ¿La nota actual todavia esta sonando? Entonces no hago nada aun.
  if (millis() - notaEmpezoEn < (unsigned long)notaDuracionMs) return;

  noTone(buzzer);                    // corta la nota anterior

  if (notaIndex >= melodyLen) {      // se acabo la melodia
    terminarShow();
    return;
  }

  int nota    = melody[notaIndex];
  int divisor = melody[notaIndex + 1];
  int dur;
  if (divisor > 0) {
    dur = wholenote / divisor;
  } else {                           // nota con puntillo: dura 1.5x
    dur = wholenote / abs(divisor);
    dur = dur + dur / 2;
  }

  tone(buzzer, nota, dur * 0.9);     // suena el 90%; el 10% final queda en silencio
  moverBrazos();                     // baila en cada nota

  notaEmpezoEn   = millis();
  notaDuracionMs = dur;
  notaIndex     += 2;                // siguiente par (nota, duracion)
}

// En reposo la cara "respira": sube y baja 2px cada 400ms. Es la prueba de que
// loop() no esta bloqueado: pasa esto mientras espera el boton.
void actualizarCaraIdle() {
  static unsigned long ultimoFrame = 0;
  static int offset = 0;
  const unsigned long RITMO_MS = 400;
  if (millis() - ultimoFrame < RITMO_MS) return;
  ultimoFrame = millis();
  offset = (offset == 0) ? 2 : 0;
  dibujarCara(offset);
}

// ===========================================================================
//  setup(): corre UNA vez al encender. Solo inicializa; NO reproduce el show.
// ===========================================================================
void setup() {
  pinMode(PIN_BOTON, INPUT_PULLUP);

  display.begin(SH1106_SWITCHCAPVCC, 0x3C);
  dibujarCara(0);                    // muestra la cara apenas enciende

  servoMotor.attach(9);
  servoMotor2.attach(10);
  servoMotor.write(BRAZO_REPOSO);
  servoMotor2.write(BRAZO_REPOSO);
}

// ===========================================================================
//  loop(): corre miles de veces por segundo. Aca vive TODA la accion ahora.
// ===========================================================================
void loop() {
  if (botonRecienApretado() && !showSonando) {
    arrancarShow();                  // apretaste el boton => empieza el show
  }

  if (showSonando) {
    actualizarShow();                // musica + brazos, sin bloquear
  } else {
    actualizarCaraIdle();            // en reposo la cara respira
  }
}
